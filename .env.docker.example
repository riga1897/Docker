# =============================================================================
# Docker Staging Environment Variables
# =============================================================================
# Этот файл используется для локальной разработки через Docker на Windows
# Промежуточное окружение между Replit (разработка) и Production VPS (деплой)
#
# Использование:
# 1. Скопируйте этот файл: copy .env.docker.example .env
# 2. Запустите: docker compose up -d
#
# Назначение:
# - Тестирование Docker образа локально
# - Проверка миграций БД в Docker
# - Отладка production конфигурации с live reload
# - Валидация перед деплоем на VPS
# =============================================================================

# =============================================================================
# Django Settings
# =============================================================================

# Режим отладки (True для staging с live reload)
DEBUG=True

# Секретный ключ Django (для staging используйте тестовый ключ)
# ВАЖНО для Docker Compose: избегайте символа $ в значении (используйте @, %, # вместо этого)
SECRET_KEY=docker-staging-secret-key-change-me-xyz123abc456def

# Разрешенные хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1

# Домен сайта (для построения URL в build_url)
SITE_DOMAIN=localhost:8000

# CORS разрешенные origins (если используете отдельный frontend)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# PostgreSQL Database
# =============================================================================

# Имя базы данных
POSTGRES_DB=lms_db

# Пользователь PostgreSQL
POSTGRES_USER=lms_user

# Пароль PostgreSQL (для staging можно использовать простой пароль)
POSTGRES_PASSWORD=lms_staging_password

# Хост базы данных (имя сервиса в docker-compose, НЕ меняйте!)
POSTGRES_HOST=db

# Порт PostgreSQL (НЕ меняйте!)
POSTGRES_PORT=5432

# Database URL формируется автоматически в Django из POSTGRES_* переменных
# НЕ нужно указывать вручную
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# Redis & Celery (имена сервисов из docker-compose, НЕ меняйте!)
# =============================================================================

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# Email Settings
# =============================================================================

# Backend для отправки email (console для staging)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Cooldown для email уведомлений (часы)
EMAIL_NOTIFICATION_COOLDOWN_HOURS=4

# =============================================================================
# Celery Tasks Configuration
# =============================================================================

# Количество дней неактивности для блокировки пользователя
INACTIVE_USER_DAYS=30

# =============================================================================
# Stripe Payment Integration
# =============================================================================

# Stripe API ключи (используйте test ключи для staging)
# Получите на https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_public_key_here

# =============================================================================
# Static & Media Files
# =============================================================================

# URL для статических файлов
STATIC_URL=/static/

# URL для медиа файлов (uploads)
MEDIA_URL=/media/

# Директория для статических файлов (при collectstatic)
STATIC_ROOT=/app/staticfiles

# Директория для медиа файлов
MEDIA_ROOT=/app/media

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=DEBUG

# =============================================================================
# Security Settings - ОТКЛЮЧЕНЫ для staging
# =============================================================================
# Для staging окружения HTTPS настройки не нужны (работаем через http://localhost)
# В production эти настройки будут в .env на VPS сервере

# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# =============================================================================
# Дополнительные настройки
# =============================================================================

# Язык приложения
# LANGUAGE_CODE=ru-ru

# Часовой пояс
# TIME_ZONE=Europe/Moscow

# Использовать ли часовые пояса в БД
# USE_TZ=True
