# Django LMS - Шаблон переменных окружения
# Скопируйте этот файл в .env и заполните своими значениями

# ===========================================
# Django Settings
# ===========================================

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-xyz123abc456

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=True

# Разрешённые хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS разрешённые источники (для отдельного фронтенда на порту 3000)
# Если у вас API-only проект (Browsable API/Swagger на том же порту 8000) - эта настройка не используется
# Для будущего React/Vue фронтенда оставьте порт 3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# PostgreSQL Database
# ===========================================

# Название базы данных
POSTGRES_DB=lms_db

# Пользователь PostgreSQL
POSTGRES_USER=lms_user

# Пароль PostgreSQL (измените в production!)
POSTGRES_PASSWORD=lms_password

# Хост базы данных (docker-compose автоматически заменит на 'db')
POSTGRES_HOST=localhost

# Порт PostgreSQL
POSTGRES_PORT=5432

# Полный URL подключения к базе данных (альтернатива отдельным переменным)
# DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/lms_db

# ===========================================
# Redis & Celery
# ===========================================

# URL для подключения к Redis
REDIS_URL=redis://localhost:6379/0

# Celery broker URL (обычно совпадает с REDIS_URL)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend (опционально)
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===========================================
# Email Settings
# ===========================================

# Backend для отправки email (console - для разработки, smtp - для production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP настройки (для production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@lms.example.com

# Cooldown для email уведомлений (часы)
EMAIL_NOTIFICATION_COOLDOWN_HOURS=4

# ===========================================
# Celery Tasks Configuration
# ===========================================

# Количество дней неактивности для блокировки пользователя
INACTIVE_USER_DAYS=30

# ===========================================
# Stripe Payment Integration
# ===========================================

# Stripe API ключи (получите на https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Webhook секрет для Stripe (для обработки событий)
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===========================================
# Static & Media Files
# ===========================================

# URL для статических файлов
STATIC_URL=/static/

# URL для медиа файлов (uploads)
MEDIA_URL=/media/

# Директория для статических файлов (при collectstatic)
# STATIC_ROOT=/app/staticfiles

# Директория для медиа файлов
# MEDIA_ROOT=/app/media

# ===========================================
# Docker-specific Settings
# ===========================================

# ВАЖНО: При запуске через Docker Compose НЕ НУЖНО менять этот файл!
# Docker Compose автоматически переопределяет следующие переменные:
# - POSTGRES_HOST: localhost → db
# - REDIS_URL: localhost:6379 → redis:6379
# - CELERY_BROKER_URL: localhost:6379 → redis:6379
#
# Подробнее см. docs/DOCKER_SETUP.md раздел "Переменные окружения"
# ===========================================
# Дополнительные настройки
# ===========================================

# Язык приложения
# LANGUAGE_CODE=ru-ru

# Часовой пояс
# TIME_ZONE=Europe/Moscow

# Использовать ли часовые пояса в БД
# USE_TZ=True
