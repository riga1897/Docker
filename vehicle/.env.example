# ============================================================================
# DJANGO НАСТРОЙКИ
# ============================================================================

# Секретный ключ Django (сгенерируйте уникальный ключ для production)
# Генерация: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Режим отладки (True для разработки, False для production)
DEBUG=True


# ============================================================================
# БАЗА ДАННЫХ (PostgreSQL)
# ============================================================================

# Для локальной разработки заполните эти переменные:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Для Replit: база данных настраивается автоматически через переменные PG*
# (PGDATABASE, PGUSER, PGPASSWORD, PGHOST, PGPORT)
# Эти переменные автоматически маппятся на DB_* в settings.py


# ============================================================================
# EMAIL НАСТРОЙКИ
# ============================================================================

# ВАРИАНТ 1: Консоль (для разработки и тестирования)
# Письма НЕ отправляются реальным получателям, а выводятся в консоль/логи
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ВАРИАНТ 2: SMTP (для production - раскомментируйте и настройте)
# Письма отправляются реальным получателям через SMTP сервер
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com              # Для Gmail
# EMAIL_HOST=smtp.yandex.ru              # Для Yandex
# EMAIL_HOST=smtp.mail.ru                # Для Mail.ru
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com


# ============================================================================
# ЛОГИРОВАНИЕ
# ============================================================================

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Вывод логов в консоль (True/False). Полезно для отладки кэша [CACHE HIT/MISS]
LOG_TO_CONSOLE=True

# Запись логов в файлы (True/False)
LOG_TO_FILE=True

# Директория для файлов логов
LOG_DIR=logs

# Максимальный размер одного файла лога в байтах (по умолчанию 5MB)
LOG_MAX_SIZE=5242880

# Количество резервных копий логов (ротация)
LOG_BACKUP_COUNT=5


# ============================================================================
# ЧАСОВОЙ ПОЯС
# ============================================================================

# Часовой пояс для отображения времени (например, Europe/Moscow, UTC, America/New_York)
TZ=Europe/Moscow


# ============================================================================
# ПЛАНИРОВЩИК РАССЫЛОК (APScheduler)
# ============================================================================

# Задержка перед первым запуском планировщика после старта приложения (в секундах)
# Для production: 30-60 секунд, для development можно уменьшить до 5-15
SCHEDULER_FIRST_RUN_DELAY=15

# Интервал проверки рассылок планировщиком (в минутах)
# Планировщик будет проверять рассылки каждые N минут
SCHEDULER_CHECK_INTERVAL_MINUTES=3


# ============================================================================
# СЕРВЕРНОЕ КЭШИРОВАНИЕ
# ============================================================================

# Глобальный переключатель кэширования (True/False)
# При False кэширование полностью отключено
CACHE_ENABLED=True

# Бэкенд кэширования:
# - locmem: хранение в памяти процесса (для development, один воркер)
# - redis: хранение в Redis (для production, несколько воркеров)
CACHE_BACKEND=locmem

# URL для подключения к Redis (используется только если CACHE_BACKEND=redis)
REDIS_URL=redis://127.0.0.1:6379/1

# Время жизни кэша в секундах
# Значения: 30-60 для development (быстрое обновление), 300-600 для production
CACHE_TIMEOUT=300
